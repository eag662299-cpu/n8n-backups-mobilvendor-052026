      "id": "2088737d-e912-4291-a330-95cf25c7d539",
      "name": "Anthropic Claude - SQL Generator",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1904,
        1440
      ]
    },
    {
      "parameters": {
        "jsCode": "const sql = $input.first().json.output || \"\";\nconst sqlClean = sql.trim().replace(/```sql/gi, '').replace(/```/g, '').trim();\n\n// Validación de seguridad del SQL generado\nconst patronesPeligrosos = ['INSERT', 'UPDATE', 'DELETE', 'DROP', 'CREATE', 'ALTER', 'TRUNCATE', 'EXEC', 'EXECUTE', '--', ';--', 'xp_'];\nconst sqlUpper = sqlClean.toUpperCase();\nconst esPeligroso = patronesPeligrosos.some(p => sqlUpper.includes(p));\nconst esSelect = sqlUpper.trim().startsWith('SELECT');\nconst tieneLimit = sqlUpper.includes('LIMIT');\n\n// Agregar LIMIT si no tiene\nlet sqlFinal = sqlClean;\nif (!tieneLimit && esSelect) {\n  sqlFinal = sqlClean + ' LIMIT 500';\n}\n\nreturn [{\n  json: {\n    ...$('Set - Contexto Usuario').first().json,\n    sql_generado: sqlFinal,\n    sql_valido: esSelect && !esPeligroso,\n    motivo_invalido: !esSelect ? 'El SQL no comienza con SELECT' : esPeligroso ? 'SQL contiene operaciones peligrosas' : null\n  }\n}];"
      },
      "id": "be7b2a4a-1476-49a5-b25b-80b090ea325f",
      "name": "Code - Validar y Limpiar SQL",
      "type": "n8n-nodes-base.code",
