    {
      "parameters": {
        "jsCode": "// Tabla de permisos por rol\nconst permisos = {\n  \"admin\": [\"*\"],\n  \"gerente_ventas\": [\"ventas\", \"clientes\", \"productos\"],\n  \"gerente_compras\": [\"compras\", \"proveedores\", \"productos\"],\n  \"operador\": [\"productos\"],\n  \"consultor\": [\"ventas\", \"clientes\"]\n};\n\nconst rol = $input.first().json.rol;\nconst servidor = $input.first().json.servidor;\n\n// Verificar si el rol tiene acceso al servidor\nconst accesos = permisos[rol] || [];\nconst tieneAcceso = accesos.includes(\"*\") || accesos.some(a => servidor.toLowerCase().includes(a));\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    tiene_acceso: tieneAcceso,\n    accesos_permitidos: accesos,\n    motivo_denegacion: tieneAcceso ? null : `Rol '${rol}' no tiene acceso al servidor '${servidor}'`\n  }\n}];"
      },
      "id": "f35e99ab-8957-44d5-9d3d-eb1d05b29275",
      "name": "Code - Validar Rol y Permisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        1312
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "51757a0a-1fde-4cc1-bc50-61d52daf079c",
              "leftValue": "={{ $json.tiene_acceso }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
