      "parameters": {
        "jsCode": "// Parse AI response - n8n v2.4\nconst items = [];\n\nfor (const item of $input.all()) {\n  let parsedData;\n  let aiResponse = item.json.message?.content || item.json.text || '';\n  \n  const originalData = $('Extract Text').first().json;\n  \n  try {\n    aiResponse = aiResponse.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    parsedData = JSON.parse(aiResponse);\n    \n    items.push({\n      json: {\n        fileName: originalData.fileName,\n        fileId: originalData.fileId,\n        fileLink: originalData.fileLink,\n        processDate: originalData.processDate,\n        textLength: originalData.textLength,\n        \n        resumen: parsedData.resumen || '',\n        temas: (parsedData.temas_principales || []).join(', '),\n        tipo_reunion: parsedData.tipo_reunion || 'No clasificado',\n        participantes: (parsedData.participantes || []).join(', '),\n        duracion: parsedData.duracion_estimada || '',\n        \n        onboarding_steps: parsedData.proceso_onboarding || [],\n        tips_comerciales: parsedData.tips_comerciales || [],\n        caracteristicas: parsedData.caracteristicas_producto || [],\n        objeciones: parsedData.objeciones_respuestas || [],\n        casos_exito: parsedData.casos_exito || [],\n        action_items: parsedData.action_items || [],\n        faqs: parsedData.preguntas_frecuentes || [],\n        \n        items_onboarding: (parsedData.proceso_onboarding || []).length,\n        items_tips: (parsedData.tips_comerciales || []).length,\n        items_caracteristicas: (parsedData.caracteristicas_producto || []).length,\n        items_objeciones: (parsedData.objeciones_respuestas || []).length,\n        \n        status: 'analysis_complete'\n      }\n    });\n    \n  } catch (error) {\n    items.push({\n      json: {\n        fileName: originalData.fileName,\n        fileId: originalData.fileId,\n        fileLink: originalData.fileLink,\n        status: 'parsing_error',\n        error: error.message,\n        raw_response: aiResponse.substring(0, 1000)\n      }\n    });\n  }\n}\n\nreturn items;"
      },
