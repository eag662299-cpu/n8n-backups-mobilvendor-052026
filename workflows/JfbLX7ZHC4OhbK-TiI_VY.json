      "parameters": {
        "jsCode": "const items = [];\nconst data = $input.first().json;\nconst steps = data.onboarding_steps || [];\nconst reunionId = $now.toFormat('yyyyMMddHHmmss');\n\nif (Array.isArray(steps) && steps.length > 0) {\n  steps.forEach((paso, index) => {\n    items.push({\n      json: {\n        reunion_id: reunionId,\n        archivo_fuente: data.fileName,\n        paso_numero: index + 1,\n        categoria: paso.categoria || 'General',\n        descripcion: paso.paso || '',\n        responsable: paso.responsable || 'N/A',\n        herramientas: paso.herramientas || '',\n        prioridad: paso.prioridad || 'Media'\n      }\n    });\n  });\n}\n\nreturn items.length > 0 ? items : [{ json: { skip: true } }];"
