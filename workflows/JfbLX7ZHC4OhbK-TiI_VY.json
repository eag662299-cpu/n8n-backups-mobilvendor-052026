    {
      "parameters": {
        "jsCode": "// Formatear datos extraídos de PDF para OpenAI\nconst items = [];\n\nfor (const item of $input.all()) {\n  const downloadNode = $('Google Drive Download1').first().json;\n  \n  // El nodo Extract from File con PDF devuelve el texto en json.text\n  const extractedText = item.json.text || item.json.data || '';\n  \n  items.push({\n    json: {\n      fileName: downloadNode.name,\n      fileId: downloadNode.id,\n      fileLink: downloadNode.webViewLink || '',\n      textContent: extractedText,\n      textLength: extractedText.length,\n      processDate: new Date().toISOString(),\n      status: 'text_extracted'\n    }\n  });\n}\n\nreturn items;"
      },
