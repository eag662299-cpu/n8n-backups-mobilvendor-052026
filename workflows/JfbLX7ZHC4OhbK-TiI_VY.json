    {
      "parameters": {
        "jsCode": "// Split tips comerciales\nconst items = [];\nconst data = $('Parse JSON1').first().json;\nconst tips = data.tips_comerciales || [];\nconst reunionId = $now.toFormat('yyyyMMddHHmmss');\n\nif (Array.isArray(tips) && tips.length > 0) {\n  tips.forEach((tip, index) => {\n    items.push({\n      json: {\n        tip_id: `TIP-${$now.toFormat('yyyyMMdd')}-${String(index + 1).padStart(3, '0')}`,\n        reunion_id: reunionId,\n        archivo_fuente: data.fileName,\n        categoria: tip.categoria || 'General',\n        tip_completo: tip.tip || '',\n        contexto: tip.contexto || 'Universal',\n        ejemplo_real: tip.ejemplo_real || '',\n        impacto: tip.impacto || ''\n      }\n    });\n  });\n}\n\nreturn items.length > 0 ? items : [{ json: { skip: true } }];"
      },
