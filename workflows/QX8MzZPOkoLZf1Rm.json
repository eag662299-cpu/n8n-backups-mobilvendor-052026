    },
    {
      "parameters": {
        "jsCode": "// DM directo — apertura según doc sección 4.3\nconst texto = $input.item.json.texto || '';\nreturn [{\n  json: {\n    ...$input.item.json,\n    dm_apertura: `¡Hola! Gracias por escribirnos 👋\\n\\nSoy del equipo de Mobilvendor. Ayudamos a empresas a ganar control y visibilidad en su operación de ventas y distribución.\\n\\nPara orientarte mejor, ¿cuál es tu nombre completo y a qué empresa perteneces?`,\n    primer_mensaje: texto\n  }\n}];"
      },
