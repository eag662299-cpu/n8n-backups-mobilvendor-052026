    {
      "parameters": {
        "jsCode": "// ════════════════════════════════════════════════════════\n// PARSER UNIVERSAL — Facebook Page + Instagram\n// Detecta: comentarios (feed), DMs Messenger, DMs IG Direct\n// ════════════════════════════════════════════════════════\n\nconst body  = $input.item.json.body;\nconst object = body?.object; // 'page' o 'instagram'\nconst entry  = body?.entry?.[0];\n\nif (!entry) return [{ json: { _skip: true, motivo: 'Sin entry' } }];\n\n// ── CASO 1: Comentario en publicación/anuncio (field: feed)\nconst changes = entry.changes || [];\nconst feedChange = changes.find(c => c.field === 'feed');\n\nif (feedChange) {\n  const val = feedChange.value;\n  // Solo nos interesan comentarios nuevos (no likes, no posts)\n  if (val.item !== 'comment' || val.verb !== 'add') {\n    return [{ json: { _skip: true, motivo: 'Feed event no es comentario nuevo' } }];\n  }\n  return [{ json: {\n    _skip:        false,\n    evento_tipo:  'COMENTARIO',\n    canal:        object === 'instagram' ? 'IG_COMENTARIO' : 'FB_COMENTARIO',\n    sender_id:    val.from?.id    || '',\n    sender_name:  val.from?.name  || '',\n    texto:        val.message     || '',\n    comment_id:   val.comment_id  || '',\n    post_id:      val.post_id     || '',\n    page_id:      entry.id        || '',\n    timestamp:    val.created_time\n  }}];\n}\n\n// ── CASO 2: DM Messenger o Instagram Direct (messaging array)\nconst messagingArr = entry.messaging || [];\nif (messagingArr.length > 0) {\n  const msg = messagingArr[0];\n  // Ignorar echo de mensajes enviados por la Page\n  if (msg.message?.is_echo) {\n    return [{ json: { _skip: true, motivo: 'Echo message ignorado' } }];\n  }\n  // Ignorar read/delivery receipts\n  if (msg.read || msg.delivery) {\n    return [{ json: { _skip: true, motivo: 'Read/delivery receipt ignorado' } }];\n  }\n  return [{ json: {\n    _skip:        false,\n    evento_tipo:  'DM',\n    canal:        object === 'instagram' ? 'IG_DM' : 'FB_DM',\n    sender_id:    msg.sender?.id    || '',\n    page_id:      msg.recipient?.id || '',\n    mid:          msg.message?.mid  || '',\n    texto:        msg.message?.text || '',\n    timestamp:    msg.timestamp,\n    // Attachments (imagen, audio, sticker)\n    attachments:  msg.message?.attachments || [],\n    // Respuesta a botón quick_reply\n    quick_reply:  msg.message?.quick_reply?.payload || null,\n    // Postback de botón (menú persistente)\n    postback_payload: msg.postback?.payload || null,\n    postback_title:   msg.postback?.title   || null\n  }}];\n}\n\nreturn [{ json: { _skip: true, motivo: 'Evento no manejado: ' + JSON.stringify(body).slice(0,200) } }];\n"
      },
