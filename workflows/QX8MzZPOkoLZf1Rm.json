    {
      "parameters": {
        "jsCode": "// Respuesta pública al comentario (según doc sección 4.1)\nconst senderName = $input.item.json.sender_name || '';\nconst nombre = senderName.split(' ')[0] || 'estimado/a';\nreturn [{\n  json: {\n    ...$input.item.json,\n    respuesta_publica: `¡Hola ${nombre}! Gracias por tu comentario 👋 Te escribimos por privado para darte información personalizada según la operación de tu empresa. ¡En un momento te contactamos!`,\n    dm_apertura: `Hola ${nombre}, te escribo desde Mobilvendor 👋\\n\\nVi tu comentario. Centralizamos y automatizamos tus procesos para ganar eficiencia ⚙️ y visibilidad total 👀. Para ver si podemos ayudarte, ¿cuál es tu nombre completo y a qué empresa perteneces?`\n  }\n}];"
      },
