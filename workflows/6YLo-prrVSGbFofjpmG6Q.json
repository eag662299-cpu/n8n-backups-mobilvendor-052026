      "name": "Code: Nurturing Msg 1 (Tip Día 2)"
    },
    {
      "parameters": {
        "jsCode": "// MENSAJE 2 (Día 5) - INSIGHT: Problema oculto\nconst lead = $input.item.json;\nconst nombre = lead.nombre_completo?.split(' ')[0] || '';\n\nconst mensaje = `Hola ${nombre}, algo que vemos mucho 📊\n\nEmpresas con rutas suelen creer que tienen control...\n\nPero cuando revisan, la información llega *tarde o incompleta*.\n\nAhí es donde empiezan los problemas de inventario y ventas.\n\n¿Sabes en cuántas horas llega la información de tus vendedores a tu sistema hoy?`;\n\nreturn [{ json: { ...lead, message: mensaje, nurturing_msg_enviado: 2 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        64
      ],
      "id": "368de611-aeb6-4db8-8e5a-877bad7f0dca",
      "name": "Code: Nurturing Msg 2 (Insight Día 5)"
    },
    {
      "parameters": {
        "jsCode": "// MENSAJE 3 (Día 9) - CASO REAL: Prueba social\nconst lead = $input.item.json;\nconst nombre = lead.nombre_completo?.split(' ')[0] || '';\n\nconst mensaje = `Te comparto un caso real 💼\n\n*Marcseal*, una empresa con operación en campo, tenía problemas en el control de ventas y liquidación.\n\nAl ordenar sus procesos lograron:\n✅ Detectar errores que antes no veían\n✅ Rutas optimizadas un 200% con geolocalización\n✅ Cobranza en tiempo real con mayor control de pagos\n\nSi quieres saber cómo replicar estos resultados en tu operación, solo responde con un *Sí* 👇`;\n\nreturn [{ json: { ...lead, message: mensaje, nurturing_msg_enviado: 3 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        224
      ],
      "id": "f9592cee-d257-4f0b-ba3f-f73d810e4751",
      "name": "Code: Nurturing Msg 3 (Caso Real Día 9)"
    },
    {
      "parameters": {
        "jsCode": "// MENSAJE 4 (Día 14) - TIP PRÁCTICO: Valor accionable\nconst lead = $input.item.json;\nconst nombre = lead.nombre_completo?.split(' ')[0] || '';\n\nconst mensaje = `${nombre}, un tip útil para tu gestión comercial diaria 💡\n\nSi tienes vendedores en campo, revisa esto:\n\n❓ ¿Puedes ver en el *mismo día* qué vendió cada uno?\n\nSi no, estás tomando decisiones con retraso.\n\nY eso impacta directamente en ventas e inventario.\n\n¿Cuánto tiempo tarda esa información en llegar hoy?`;\n\nreturn [{ json: { ...lead, message: mensaje, nurturing_msg_enviado: 4 } }];"
      },
