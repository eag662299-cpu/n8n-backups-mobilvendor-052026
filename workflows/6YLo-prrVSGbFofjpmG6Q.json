      "parameters": {
        "jsCode": "// Calcula qué mensaje de nurturing enviar según días desde entrada al flujo\nconst lead = $input.item.json;\n\nconst ahora = Date.now();\nconst fechaEntrada = new Date(lead.nurturing_start || lead.wa_last_contact || 0).getTime();\nconst diasTranscurridos = (ahora - fechaEntrada) / (1000 * 60 * 60 * 24);\nconst mensajeYaEnviado = parseInt(lead.nurturing_msg || 0);\n\n// Calendario de nurturing según PDF:\n// Msg 1 (tip):     Día 2\n// Msg 2 (insight): Día 5  \n// Msg 3 (caso):    Día 9\n// Msg 4 (tip2):    Día 14\n// Msg 5 (reactiv): Día 21\nconst calendario = [\n  { msg: 1, diasMinimos: 2 },\n  { msg: 2, diasMinimos: 5 },\n  { msg: 3, diasMinimos: 9 },\n  { msg: 4, diasMinimos: 14 },\n  { msg: 5, diasMinimos: 21 }\n];\n\n// Busca el próximo mensaje a enviar\nconst proximoMensaje = calendario.find(c => \n  c.msg > mensajeYaEnviado && diasTranscurridos >= c.diasMinimos\n);\n\nif (!proximoMensaje) return []; // No hay mensaje que enviar hoy\n\nreturn [{\n  json: {\n    ...lead,\n    nurturing_msg_a_enviar: proximoMensaje.msg,\n    dias_en_nurturing: Math.floor(diasTranscurridos)\n  }\n}];"
      },
