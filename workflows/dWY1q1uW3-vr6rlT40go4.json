        "parameters": {
          "jsCode": "const body = $json.body || {};\nlet metadata = {};\ntry {\n  metadata = typeof body.metadata === 'string' ? JSON.parse(body.metadata) : (body.metadata || {});\n} catch (e) {\n  metadata = { parseError: String(e) };\n}\n\nreturn [{\n  json: {\n    receivedAt: new Date().toISOString(),\n    sessionId: body.sessionId || metadata.sessionId || '',\n    metadata,\n    tabTitle: metadata.tab?.title || '',\n    tabUrl: metadata.tab?.url || ''\n  },\n  binary: {\n    audio: $binary.audio\n  }\n}];"
        },
        "id": "a3119665-4991-4bed-862d-4e8fd01bad82",
