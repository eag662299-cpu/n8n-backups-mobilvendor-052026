      {
        "parameters": {
          "jsCode": "const hasAudio = Boolean($binary && $binary.audio);\nconst metadata = $json.metadata || {};\nconst sessionId = $json.sessionId || '';\nconst sizeBytes = Number(metadata.sizeBytes || 0);\n\nconst errors = [];\nif (!hasAudio) errors.push('Missing binary audio field.');\nif (!sessionId) errors.push('Missing sessionId.');\nif (!metadata.chunkTimestamp) errors.push('Missing metadata.chunkTimestamp.');\nif (!metadata.tab || !metadata.tab.url) errors.push('Missing metadata.tab.url.');\nif (sizeBytes > 25 * 1024 * 1024) errors.push('Audio chunk too large (>25MB).');\n\nreturn [{\n  json: {\n    ...$json,\n    validationOk: errors.length === 0,\n    validationErrors: errors\n  },\n  binary: $binary\n}];"
        },
