    {
      "parameters": {
        "jsCode": "const XLSX = require('xlsx');\n\n// Leer el binario descargado de Drive\nconst binaryKey = Object.keys($input.first().binary)[0];\nconst buffer = Buffer.from($input.first().binary[binaryKey].data, 'base64');\n\nconst wb = XLSX.read(buffer, { type: 'buffer' });\nconst ws = wb.Sheets['SMA-QoS-9'];\n\nif (!ws) throw new Error('Hoja SMA-QoS-9 no encontrada');\n\nconst rows = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });\n\nconst header_row = rows[11] || []; // Fila 12 índice 11\nconst data_row   = rows[12] || []; // Fila 13 índice 12\n\nreturn [{\n  json: {\n    headerRow: header_row,\n    dataRow:   data_row,\n    fileName:  $input.first().binary[binaryKey].fileName || 'unknown'\n  }\n}];"
      },
      "id": "66be3049-d2fb-4beb-aca8-ed3314cf3a39",
