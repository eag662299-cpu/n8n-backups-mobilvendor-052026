    {
      "parameters": {
        "jsCode": "// Equivalente exacto al DataFrame de Python\nconst items = $input.first().json.data;\n\n// Header del PRIMER archivo (índice 11)\nconst header_row = items[0].headerRow;\n\n// Fila 13 (índice 12) de TODOS los archivos\nconst df = items.map(item => {\n  const obj = {};\n  header_row.forEach((col, i) => {\n    obj[String(col)] = item.dataRow[i] !== undefined ? item.dataRow[i] : '';\n  });\n  return obj;\n});\n\nreturn df.map(row => ({ json: row }));"
      },
