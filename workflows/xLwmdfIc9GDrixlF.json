      "typeVersion": 4,
      "position": [
        944,
        1152
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst row = $input.first().json;\nif (!row.accepted) throw new Error('No existe consentimiento expreso');\nif ((row.from || '').replace(/\\D/g,'') !== (row.tutor_telefono || '').replace(/\\D/g,'')) throw new Error('Número no coincide');\nif ((row.otp || '') !== String(row.otp)) throw new Error('OTP inválido');\nif (new Date(row.expiresAt) < new Date()) throw new Error('OTP expirado');\nconst evidence = {\n sessionId: row.sessionId,\n tutor: row.tutor_nombre,\n tutorCedula: row.tutor_cedula || '',\n tutorTelefono: row.tutor_telefono,\n colegio: row.colegio_nombre,\n estudiante: row.estudiante,\n grado: row.grado_paralelo,\n responsableRetiro: row.responsable_retiro,\n fechaSalida: row.fecha_salida,\n consentimientoTexto: row.consentMessage,\n respuestaTutor: row.rawMessage,\n fechaAceptacion: row.inboundAt,\n canal: 'WhatsApp',\n proveedor: 'Twilio',\n twilioSid: row.twilioSid\n};\nconst evidenceJson = JSON.stringify(evidence, null, 2);\nconst evidenceHash = crypto.createHash('sha256').update(evidenceJson).digest('hex');\nreturn [{json:{...row, status:'AUTORIZADO', acceptedAt:row.inboundAt, evidenceJson, evidenceHash}}];"
      },
