    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst text = (body.Body || '').trim();\nconst from = (body.From || '').replace('whatsapp:','');\nconst session = text.match(/AUTH-[A-Za-z0-9-]+/);\nconst otp = text.match(/(\\d{6})/);\nreturn [{json:{rawMessage:text, from, sessionId: session ? session[0] : '', otp: otp ? otp[1] : '', accepted:/SI ACEPTO/i.test(text), inboundAt:new Date().toISOString(), twilioSid: body.MessageSid || ''}}];"
      },
