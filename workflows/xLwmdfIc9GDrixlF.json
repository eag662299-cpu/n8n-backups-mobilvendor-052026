      {
        "parameters": {
          "jsCode": "const now = new Date();\nconst rows = $input.all().map(i => i.json);\nconst out = [];\nfor (const row of rows) {\n  if (row.status !== 'PENDIENTE_FIRMA') continue;\n  const created = new Date(row.createdAt);\n  const expires = new Date(row.expiresAt);\n  const diffMin = (now - created) / 60000;\n  if (now > expires) {\n    out.push({ json: { ...row, action: 'expire' } });\n  } else if (diffMin >= 10 && diffMin < 15) {\n    out.push({ json: { ...row, action: 'remind' } });\n  }\n}\nreturn out;"
        },
