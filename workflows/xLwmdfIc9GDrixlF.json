    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst otp = Math.floor(100000 + Math.random() * 900000).toString();\nconst sessionId = `AUTH-${Date.now()}-${Math.random().toString(36).slice(2,8)}`;\nconst consentMessage = `AUTORIZACIÓN DE SALIDA\\nColegio: ${payload.colegio_nombre}\\nEstudiante: ${payload.estudiante}\\nCurso: ${payload.grado_paralelo}\\nFecha/Hora: ${payload.fecha_salida}\\nResponsable de retiro: ${payload.responsable_retiro}\\nMotivo: ${payload.motivo || ''}\\nRepresentante: ${payload.tutor_nombre}\\nCédula: ${payload.tutor_cedula || ''}\\nTeléfono: ${payload.tutor_telefono}\\n\\nConfirmo expresamente mi consentimiento para usar medios electrónicos y mensajes de datos en esta autorización escolar.\\n\\nPara aprobar responde exactamente: SI ACEPTO ${otp} ${sessionId}`;\nreturn [{json:{...payload, otp, sessionId, consentMessage, status:'PENDIENTE_FIRMA', createdAt:new Date().toISOString(), expiresAt:new Date(Date.now()+15*60*1000).toISOString()}}];"
      },
