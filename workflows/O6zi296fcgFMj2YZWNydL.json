        "jsCode": "\n// Preparar datos para actualizar la fila en Google Sheets\nconst item = $input.first().json;\nconst ahora = new Date();\nconst fechaHoy = `${String(ahora.getDate()).padStart(2,'0')}-${String(ahora.getMonth()+1).padStart(2,'0')}-${ahora.getFullYear()}`;\n\nreturn [{\n  json: {\n    phone:          item.phone,\n    attemps:        String(item.nuevo_attemps),\n    last_message:   `Seguimiento_${item.label_intento}_${fechaHoy}`,\n    mode:           item.es_ultimo_intento ? 'lead_frio' : 'seguimiento',\n    // Campos de identidad (para match en GSheets)\n    email:          item.email || '',\n    nombre:         item.nombre || '',\n    empresa:        item.empresa || '',\n    // Metadata follow-up\n    _es_ultimo:     item.es_ultimo_intento,\n    _id_lead:       item.id_lead || '',\n    _label_intento: item.label_intento,\n    _phone_e164:    item.phone_e164\n  }\n}];\n"
