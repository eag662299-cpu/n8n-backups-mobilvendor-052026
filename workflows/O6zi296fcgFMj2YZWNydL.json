    {
      "parameters": {
        "jsCode": "\n// ============================================================\n// FILTRAR LEADS INACTIVOS SIN RESPUESTA EN WHATSAPP\n// ============================================================\nconst now = new Date();\nconst msPerDay = 1000 * 60 * 60 * 24;\nconst results = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  // 1. Skip si ya está calificado (MQL completado)\n  const mql1 = String(row.MQL1 || '').toLowerCase() === 'true';\n  const mql2 = String(row.MQL2 || '').toLowerCase() === 'true';\n  if (mql1 && mql2) continue;\n\n  // 2. Skip si no tiene teléfono válido\n  const phone = String(row.phone || '').trim();\n  if (!phone || phone.replace(/\\D/g, '').length < 9) continue;\n\n  // 3. Número de intentos de follow-up\n  const attemps = parseInt(row.attemps || '0') || 0;\n  if (attemps >= 3) continue; // Ya tiene 3 intentos, se marca como frío\n\n  // 4. Parsear fecha de creación (formato dd-MM-yyyy)\n  const fechaStr = String(row['fecha '] || row.fecha || '').trim();\n  if (!fechaStr) continue;\n  const parts = fechaStr.split('-');\n  if (parts.length !== 3) continue;\n  const fechaCreacion = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));\n  if (isNaN(fechaCreacion.getTime())) continue;\n\n  const diasDesdeCreacion = Math.floor((now - fechaCreacion) / msPerDay);\n\n  // 5. Ventana de tiempo para cada intento\n  // Intento 0→1: entre día 1 y 3\n  // Intento 1→2: entre día 4 y 10\n  // Intento 2→3: entre día 11 y 20\n  const ventanas = [\n    { min: 1,  max: 3  },\n    { min: 4,  max: 10 },\n    { min: 11, max: 20 }\n  ];\n  const ventana = ventanas[attemps];\n  if (diasDesdeCreacion < ventana.min || diasDesdeCreacion > ventana.max) continue;\n\n  // 6. Normalizar teléfono a E.164\n  const digits = phone.replace(/\\D/g, '');\n  const phoneE164 = phone.startsWith('+') ? phone : '+' + digits;\n\n  // 7. Determinar tipo de mensaje según intento\n  const tiposIntento = [\n    { template: 'seguimiento_wa_intento1_mv', label: 'Recordatorio_D1' },\n    { template: 'seguimiento_wa_intento2_mv', label: 'PropuestaValor_D4' },\n    { template: 'seguimiento_wa_final_mv',    label: 'UltimaOportunidad_D11' }\n  ];\n  const intenTipo = tiposIntento[attemps];\n\n  results.push({\n    json: {\n      ...row,\n      phone_e164:            phoneE164,\n      attemps_num:           attemps,\n      dias_desde_creacion:   diasDesdeCreacion,\n      template_wa:           intenTipo.template,\n      label_intento:         intenTipo.label,\n      nombre:                String(row.nombre  || 'Cliente').trim(),\n      empresa:               String(row.empresa || '').trim(),\n      nuevo_attemps:         attemps + 1,\n      es_ultimo_intento:     attemps === 2\n    }\n  });\n}\n\n// Retorna vacío especial si no hay leads\nif (results.length === 0) {\n  return [{ json: { _sin_leads: true, total: 0, fecha_ejecucion: now.toISOString() } }];\n}\n\nreturn results;\n"
      },
