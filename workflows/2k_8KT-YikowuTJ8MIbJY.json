    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst folders = [];\n\nitems.forEach(item => {\n  const data = item.json.value || [item.json];\n  \n  data.forEach(doc => {\n    folders.push({\n      id: doc.id,\n      nombre: doc.name,\n      url: doc.webUrl,\n      tipo: doc.folder ? 'Carpeta' : 'Archivo',\n      cantidadHijos: doc.folder?.childCount || 0,\n      tamaño: doc.size || 0,\n      fechaCreacion: doc.createdDateTime,\n      fechaModificacion: doc.lastModifiedDateTime\n    });\n  });\n});\n\nreturn folders.map(f => ({ json: f }));\n"
      },
